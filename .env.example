# Copy to .env, then restart Expo — EXPO_PUBLIC_* values are inlined
# into the bundle at build time.

# Reference vision backend running on your computer (see `npm run server`).
# Use your computer's LAN IP on the same Wi-Fi — the phone cannot reach
# "localhost". Leave unset to use the built-in offline mock instead.
EXPO_PUBLIC_VISION_API_URL=http://192.168.1.20:8787/analyze

# Server-side only — NEVER put a model key in the app or in EXPO_PUBLIC_*:
#   VISION_API_KEY=sk-... npm run server
# Optional: VISION_API_URL (default OpenAI chat completions),
#           VISION_MODEL (default gpt-4o-mini), PORT (default 8787).
#
# FREE options (pick one):
#
# 1. Meta Llama, local (free forever, offline, most private):
#      ollama serve                       # one terminal
#      ollama pull llama3.2-vision        # ~8 GB, one-time
#      VISION_API_URL=http://localhost:11434/v1/chat/completions \
#      VISION_MODEL=llama3.2-vision VISION_API_KEY=ollama npm run server
#
# 2. Google Gemini free tier (cloud, no card; key from Google AI Studio):
#      VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions \
#      VISION_MODEL=gemini-2.5-flash VISION_API_KEY=<AI Studio key> npm run server
